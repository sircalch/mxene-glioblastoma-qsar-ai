&CONTROL
  calculation = 'relax'
  prefix = 'd_Carmustine'
  outdir = './tmp'
  pseudo_dir = '/home/andres/pseudo/SSSP_1.3.0_PBE_efficiency'
  forc_conv_thr = 2.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 200
/
&SYSTEM
  ibrav = 0
  nat = 21
  ntyp = 5
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'dft-d3'
  nosym = .true.
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  mixing_ndim = 10
  electron_maxstep = 300
/
&IONS
  ion_dynamics = 'bfgs'
/
