  mixing_ndim = 10
  electron_maxstep = 300
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = '2Dxy'
  press_conv_thr = 0.2
/
